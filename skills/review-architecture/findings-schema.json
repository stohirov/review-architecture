{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Contract for architecture-findings.json. scripts/validate-findings.mjs interprets this file directly; keep to the keywords it supports.",
  "type": "object",
  "required": ["schema_version", "mode", "target", "profile", "findings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "mode": { "enum": ["codebase", "design", "hybrid"] },
    "target": {
      "type": "string",
      "minLength": 1,
      "description": "Repo path or project name that was reviewed."
    },
    "profile": {
      "type": "object",
      "required": ["architecture", "summary"],
      "additionalProperties": false,
      "properties": {
        "architecture": { "enum": ["monolith", "modular-monolith", "microservices", "serverless", "unknown"] },
        "summary": { "type": "string", "minLength": 1 },
        "stack": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "deployables": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "datastores": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "messaging": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "lenses_run": {
          "type": "array",
          "items": { "enum": ["scalability", "data-consistency", "resilience", "service-boundaries", "messaging", "persistence", "operability"] }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "lens", "title", "severity", "confidence", "locations", "evidence", "failure_scenario", "recommendation", "pattern", "applies_when", "effort"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]{2,5}-[0-9]{3}$",
            "description": "Lens prefix plus sequence, e.g. DC-001. Unique within the file."
          },
          "lens": { "enum": ["scalability", "data-consistency", "resilience", "service-boundaries", "messaging", "persistence", "operability"] },
          "title": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "confidence": { "enum": ["high", "medium", "low"] },
          "locations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["file"],
              "additionalProperties": false,
              "properties": {
                "file": { "type": "string", "minLength": 1, "description": "Repo-relative path, or the brief's filename in design mode." },
                "line": { "type": "integer", "minimum": 1 },
                "section": { "type": "string", "minLength": 1, "description": "Heading in the brief (design mode) or symbol name." }
              }
            }
          },
          "evidence": { "type": "string", "minLength": 1, "description": "Quoted code or brief text that shows the problem." },
          "failure_scenario": { "type": "string", "minLength": 1, "description": "Concrete sequence of events that goes wrong." },
          "recommendation": { "type": "string", "minLength": 1 },
          "pattern": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Kebab-case name of the recommended pattern, from the lens vocabulary, e.g. transactional-outbox."
          },
          "applies_when": { "type": "string", "minLength": 1, "description": "The condition in this project that makes the recommendation proportionate." },
          "effort": { "enum": ["small", "medium", "large"] }
        }
      }
    },
    "strengths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Things the architecture already does well."
    }
  }
}
